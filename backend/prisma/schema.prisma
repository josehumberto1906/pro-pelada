generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Jogador {
  id        Int      @id @default(autoincrement())
  nome      String
  posicao   String
  nota      Int      @default(5)
  createdAt DateTime @default(now())
}

model Partida {
  id     Int      @id @default(autoincrement())
  data   DateTime
  local  String
  status String   @default("Agendada")
}